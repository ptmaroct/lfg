                                ▌ lfg │ BACKUP                                                                                                                  
                              ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━                              
                                                                                                                                                                
                              ┃ ENCRYPT THE BACKUP?                                                                                                             
                                                                                                                                                                
                              ▸ 01  YES   .tar.age                                                                                                              
                                     Encrypted via age. Need ~/.config/lfg/key.txt to restore. Safer for dotfiles + env.                                        
                                                                                                                                                                
                                02  NO    .tar.gz                                                                                                               
                                     Plain tar.gz. Inspectable. DO NOT include secrets.                                                                         
                                                                                                                                                                
                                                                                                                                                                
                                                                                                                                                                
